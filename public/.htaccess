<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # One address for search engines: https://omniviatech.co.ke
    # THE_REQUEST is the address the visitor asked for, before the hosting
    # rewrite into the public folder.
    RewriteCond %{THE_REQUEST} !\s/\.well-known/
    RewriteCond %{HTTP_HOST} ^www\.omniviatech\.co\.ke$ [NC]
    RewriteCond %{THE_REQUEST} ^[A-Z]+\s(/[^\s]*)\s
    RewriteRule ^ https://omniviatech.co.ke%1 [L,R=301,NE]

    RewriteCond %{THE_REQUEST} !\s/\.well-known/
    RewriteCond %{HTTP_HOST} ^omniviatech\.co\.ke$ [NC]
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteCond %{THE_REQUEST} ^[A-Z]+\s(/[^\s]*)\s
    RewriteRule ^ https://omniviatech.co.ke%1 [L,R=301,NE]

    RewriteCond %{HTTP_HOST} ^omniviatech\.co\.ke$ [NC]
    RewriteCond %{THE_REQUEST} ^[A-Z]+\s/public(/[^\s]*)?\s
    RewriteRule ^ https://omniviatech.co.ke%1 [L,R=301,NE]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{THE_REQUEST} ^[A-Z]+\s(/[^\s?]*[^\s?/])/+(\?[^\s]*)?\s
    RewriteRule ^ %1%2 [L,R=301,NE]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>
