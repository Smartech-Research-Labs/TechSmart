# Node.js Server Configuration (Socket.IO + BullMQ)

# Server Settings
PORT=3000
NODE_ENV=development

# Laravel API
APP_URL=http://localhost:8000
API_BASE_URL=http://localhost:8000/api/v1
API_TOKEN=your_sanctum_token_here

# Redis Configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# OpenAI (for AI worker tasks)
OPENAI_API_KEY=sk-proj-your-api-key-here

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:8000,http://localhost:5173

# Worker Configuration
EMAIL_QUEUE_CONCURRENCY=5
AI_QUEUE_CONCURRENCY=3
NOTIFICATION_QUEUE_CONCURRENCY=10
REPORT_QUEUE_CONCURRENCY=2

# Rate Limits (per second/minute)
EMAIL_RATE_LIMIT=10
AI_RATE_LIMIT=5
REPORT_RATE_LIMIT=10

# Logging
LOG_LEVEL=info
