    <!-- Request a Quote -->
    <section class="py-16 md:py-20">
      <div class="container mx-auto px-6">
        <div class="grid lg:grid-cols-2 gap-12 items-center">
          <div>
            <p class="text-accent text-xs font-semibold tracking-widest uppercase mb-3">Get Started</p>
            <h2 class="text-2xl md:text-3xl font-bold text-foreground leading-tight mb-3">Request a Quote</h2>
            <p class="text-muted-foreground text-sm mb-8">Tell us about your project and we will get back to you within 24 hours.</p>

            <form @submit.prevent="submitQuoteRequest" class="space-y-4">
              <div class="grid grid-cols-2 gap-4">
                <input v-model="quoteForm.name" type="text" required class="w-full px-4 py-2.5 bg-muted/50 border border-border rounded-md focus:outline-none focus:ring-2 focus:ring-primary/50 text-foreground text-sm" placeholder="Full Name *" />
                <input v-model="quoteForm.email" type="email" required class="w-full px-4 py-2.5 bg-muted/50 border border-border rounded-md focus:outline-none focus:ring-2 focus:ring-primary/50 text-foreground text-sm" placeholder="Email *" />
              </div>
              <div class="grid grid-cols-2 gap-4">
                <input v-model="quoteForm.phone" type="tel" required class="w-full px-4 py-2.5 bg-muted/50 border border-border rounded-md focus:outline-none focus:ring-2 focus:ring-primary/50 text-foreground text-sm" placeholder="Phone *" />
                <select v-model="quoteForm.service" required class="w-full px-4 py-2.5 bg-muted/50 border border-border rounded-md focus:outline-none focus:ring-2 focus:ring-primary/50 text-foreground text-sm">
                  <option value="">Service Needed *</option>
                  <option v-for="service in allServices" :key="service.id" :value="service.title">{{ service.title }}</option>
                </select>
              </div>
              <textarea v-model="quoteForm.description" required rows="3" class="w-full px-4 py-2.5 bg-muted/50 border border-border rounded-md focus:outline-none focus:ring-2 focus:ring-primary/50 text-foreground text-sm resize-none" placeholder="Tell us about your project..."></textarea>
              <div class="grid grid-cols-2 gap-4">
                <select v-model="quoteForm.budget" class="w-full px-4 py-2.5 bg-muted/50 border border-border rounded-md focus:outline-none focus:ring-2 focus:ring-primary/50 text-foreground text-sm">
                  <option value="">Budget Range</option>
                  <option value="Under Ksh 10,000">Under Ksh 10,000</option>
                  <option value="Ksh 10,000 - Ksh 50,000">Ksh 10,000 - Ksh 50,000</option>
                  <option value="Ksh 50,000 - Ksh 200,000">Ksh 50,000 - Ksh 200,000</option>
                  <option value="Over Ksh 200,000">Over Ksh 200,000</option>
                </select>
                <select v-model="quoteForm.timeline" class="w-full px-4 py-2.5 bg-muted/50 border border-border rounded-md focus:outline-none focus:ring-2 focus:ring-primary/50 text-foreground text-sm">
                  <option value="">Timeline</option>
                  <option value="ASAP">ASAP</option>
                  <option value="1-2 months">1-2 months</option>
                  <option value="3-6 months">3-6 months</option>
                  <option value="6+ months">6+ months</option>
                </select>
              </div>
              <button type="submit" :disabled="quoteFormSubmitting" class="w-full px-5 py-3 bg-primary text-white text-sm font-semibold rounded-md hover:bg-primary/90 disabled:opacity-50 transition-all">
                {{ quoteFormSubmitting ? 'Submitting...' : 'Submit Quote Request' }}
              </button>
            </form>
          </div>
          <div class="hidden lg:block">
            <div class="rounded-lg overflow-hidden">
              <img src="https://images.unsplash.com/photo-1553877522-43269d4ea984?w=800&h=600&fit=crop&q=80" alt="Get a Quote" class="w-full h-full object-cover aspect-[4/3]" />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Newsletter -->
    <section class="py-12 bg-muted/30 border-y border-border">
      <div class="container mx-auto px-6 max-w-2xl text-center">
        <h3 class="text-lg font-bold text-foreground mb-2">Stay Updated</h3>
        <p class="text-muted-foreground text-sm mb-5">Join our newsletter for the latest industry news and exclusive offers.</p>
        <form @submit.prevent="submitNewsletter" class="flex gap-3 max-w-md mx-auto">
          <input v-model="newsletterEmail" type="email" required class="flex-1 px-4 py-2.5 bg-card border border-border rounded-md focus:outline-none focus:ring-2 focus:ring-primary/50 text-foreground text-sm" placeholder="Enter your email" />
          <button type="submit" :disabled="newsletterSubmitting" class="px-5 py-2.5 bg-primary text-white text-sm font-semibold rounded-md hover:bg-primary/90 disabled:opacity-50 transition-all whitespace-nowrap">
            {{ newsletterSubmitting ? 'Subscribing...' : 'Subscribe' }}
          </button>
        </form>
      </div>
    </section>

    <!-- Contact Section -->
    <section class="py-16 md:py-20">
      <div class="container mx-auto px-6">
        <div class="max-w-xl mb-10">
          <p class="text-primary text-xs font-semibold tracking-widest uppercase mb-3">Get In Touch</p>
          <h2 class="text-2xl md:text-3xl font-bold text-foreground leading-tight mb-3">Contact Us</h2>
          <p class="text-muted-foreground text-sm">Have a question? We are here to help.</p>
        </div>

        <div class="grid lg:grid-cols-2 gap-10">
          <div class="space-y-4">
            <div v-if="settings.address" class="flex items-start gap-4 p-4 bg-card border border-border rounded-lg">
              <div class="w-10 h-10 shrink-0 bg-primary/10 rounded-lg flex items-center justify-center">
                <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
              </div>
              <div>
                <h4 class="font-semibold text-foreground text-sm mb-0.5">Address</h4>
                <p class="text-muted-foreground text-xs">{{ settings.address }}</p>
              </div>
            </div>
            <div v-if="settings.contact_email" class="flex items-start gap-4 p-4 bg-card border border-border rounded-lg">
              <div class="w-10 h-10 shrink-0 bg-accent/10 rounded-lg flex items-center justify-center">
                <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
              </div>
              <div>
                <h4 class="font-semibold text-foreground text-sm mb-0.5">Email</h4>
                <a :href="`mailto:${settings.contact_email}`" class="text-muted-foreground text-xs hover:text-primary transition">{{ settings.contact_email }}</a>
              </div>
            </div>
            <div v-if="settings.contact_phone" class="flex items-start gap-4 p-4 bg-card border border-border rounded-lg">
              <div class="w-10 h-10 shrink-0 bg-green-500/10 rounded-lg flex items-center justify-center">
                <svg class="w-5 h-5 text-green-600 dark:text-green-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
              </div>
              <div>
                <h4 class="font-semibold text-foreground text-sm mb-0.5">Phone</h4>
                <a :href="`tel:${settings.contact_phone}`" class="text-muted-foreground text-xs hover:text-primary transition">{{ settings.contact_phone }}</a>
              </div>
            </div>
            <div class="aspect-video bg-muted rounded-lg overflow-hidden border border-border">
              <iframe
                src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3988.8!2d36.82!3d-1.28!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0!2sNairobi!5e0!3m2!1sen!2ske!4v1234567890"
                width="100%" height="100%" style="border:0;" allowfullscreen loading="lazy" referrerpolicy="no-referrer-when-downgrade"
              ></iframe>
            </div>
          </div>

          <div>
            <form @submit.prevent="submitContactForm" class="bg-card border border-border rounded-lg p-6">
              <div class="mb-4">
                <label class="block text-xs font-semibold text-foreground mb-1.5">Your Name</label>
                <input v-model="contactForm.name" type="text" required class="w-full px-4 py-2.5 bg-background border border-border rounded-md focus:outline-none focus:ring-2 focus:ring-primary/50 text-foreground text-sm" placeholder="John Doe" />
              </div>
              <div class="mb-4">
                <label class="block text-xs font-semibold text-foreground mb-1.5">Email Address</label>
                <input v-model="contactForm.email" type="email" required class="w-full px-4 py-2.5 bg-background border border-border rounded-md focus:outline-none focus:ring-2 focus:ring-primary/50 text-foreground text-sm" placeholder="john@example.com" />
              </div>
              <div class="mb-4">
                <label class="block text-xs font-semibold text-foreground mb-1.5">Phone Number</label>
                <input v-model="contactForm.phone" type="tel" class="w-full px-4 py-2.5 bg-background border border-border rounded-md focus:outline-none focus:ring-2 focus:ring-primary/50 text-foreground text-sm" placeholder="+254 710 351 517" />
              </div>
              <div class="mb-4">
                <label class="block text-xs font-semibold text-foreground mb-1.5">Message</label>
                <textarea v-model="contactForm.message" required rows="4" class="w-full px-4 py-2.5 bg-background border border-border rounded-md focus:outline-none focus:ring-2 focus:ring-primary/50 text-foreground text-sm resize-none" placeholder="How can we help you?"></textarea>
              </div>
              <button type="submit" :disabled="contactFormSubmitting" class="w-full px-5 py-3 bg-primary text-white text-sm font-semibold rounded-md hover:bg-primary/90 disabled:opacity-50 transition-all">
                {{ contactFormSubmitting ? 'Sending...' : 'Send Message' }}
              </button>
            </form>
          </div>
        </div>
      </div>
    </section>

    <!-- Trusted By - Grid Layout -->
    <section v-if="clients.length" class="py-12 border-t border-border">
      <div class="container mx-auto px-6">
        <div class="grid lg:grid-cols-[200px_1fr] gap-8 items-center">
          <div>
            <p class="text-sm font-semibold text-foreground">Trusted By</p>
            <p class="text-xs text-muted-foreground mt-1">Leading companies across Africa</p>
          </div>
          <div class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-5 lg:grid-cols-6 gap-6">
            <a
              v-for="client in clients"
              :key="client.id"
              :href="client.website_url"
              target="_blank"
              rel="noopener"
              class="flex items-center justify-center opacity-40 hover:opacity-100 transition-opacity duration-300"
            >
              <img v-if="client.logo_url" :src="client.logo_url" :alt="client.name" class="max-h-10 max-w-full grayscale hover:grayscale-0 transition" />
              <span v-else class="text-muted-foreground font-medium text-xs">{{ client.name }}</span>
            </a>
          </div>
        </div>
      </div>
    </section>
  </PublicLayout>
</template>

<script setup lang="ts">
import { ref, computed, onMounted } from 'vue';
import { Swiper, SwiperSlide } from 'swiper/vue';
import { Autoplay, Pagination, EffectFade } from 'swiper/modules';
import 'swiper/css';
import 'swiper/css/pagination';
import 'swiper/css/effect-fade';
import PublicLayout from '@/layouts/PublicLayout.vue';
import WishlistButton from '@/components/WishlistButton.vue';
import axios from 'axios';
import { useToast } from '@/composables';

// Data from API
const sliders = ref<any[]>([]);
const counters = ref<any[]>([]);
const allServices = ref<any[]>([]);
const products = ref<any[]>([]);
const clients = ref<any[]>([]);
const topReviews = ref<any[]>([]);
const faqs = ref<any[]>([]);
const recentBlogs = ref<any[]>([]);
const settings = ref<any>({});
const toast = useToast();

// Service Filtering
const activeServiceTab = ref('all');
const serviceGroups = computed(() => {
  const groups = [...new Set(allServices.value.map((s: any) => s.category_group).filter(Boolean))];
  return groups;
});

const filteredServices = computed(() => {
  if (activeServiceTab.value === 'all') {
    return allServices.value.slice(0, 9);
  }
  return allServices.value.filter((s: any) => s.category_group === activeServiceTab.value);
});

// UI State
const counterRefs = ref<HTMLElement[]>([]);
const openFaqIndex = ref<number | null>(null);

// Why Choose Us
const whyChooseUs = [
  { emoji: '\uD83D\uDE80', title: 'Rapid Delivery', description: 'We ship MVPs in weeks, not months. Agile sprints with weekly demos keep you informed.' },
  { emoji: '\uD83C\uDFAF', title: 'Result-Focused', description: 'Every solution is designed to drive measurable business outcomes  traffic, conversions, revenue.' },
  { emoji: '\uD83D\uDEE1\uFE0F', title: 'Enterprise Security', description: 'POPIA-compliant, SOC-certified, and built with security-first architecture from day one.' },
  { emoji: '\uD83E\uDD1D', title: 'Dedicated Support', description: '24/7 priority support with dedicated project managers and transparent communication.' },
];

// Form State
const quoteForm = ref({
  name: '',
  email: '',
  phone: '',
  service: '',
  description: '',
  budget: '',
  timeline: '',
});
const quoteFormSubmitting = ref(false);

const newsletterEmail = ref('');
const newsletterSubmitting = ref(false);

const contactForm = ref({
  name: '',
  email: '',
  phone: '',
  message: '',
});
const contactFormSubmitting = ref(false);

// Fetch Data
async function fetchHomeData() {
  try {
    const { data } = await axios.get('/api/v1/home');
    const d = data.data || data;
    sliders.value = d.sliders || [];
    counters.value = d.counters || [];
    allServices.value = d.all_services || d.featured_services || [];
    products.value = d.featured_products || [];
    clients.value = d.clients || [];
    topReviews.value = d.top_reviews || [];
    // If API returned no reviews, use representative testimonials
    if (!topReviews.value.length) {
      topReviews.value = [
        { id: 1, rating: 5, comment: 'Outstanding service! TechSmart built our e-commerce platform in record time with exceptional quality. Our online sales increased by 200% within three months of launch.', user_name: 'David Okonkwo', company: 'CEO, AfricaTrade' },
        { id: 2, rating: 5, comment: 'The team is incredibly professional. They delivered our mobile app ahead of schedule and under budget. The React Native app runs flawlessly on both iOS and Android.', user_name: 'Sarah van der Merwe', company: 'CTO, FinSync SA' },
        { id: 3, rating: 5, comment: 'Their automation solutions saved us over 200 hours monthly. The CI/CD pipeline they built reduced our deployment time from days to minutes.', user_name: 'Michael Ndlovu', company: 'Operations Manager, LogiTech' },
        { id: 4, rating: 5, comment: 'They transformed our outdated website into a modern, responsive platform that doubled our leads. The SEO work took us from page 5 to page 1 of Google in under 4 months.', user_name: 'Grace Molefe', company: 'Marketing Director, GreenEnergy' },
        { id: 5, rating: 5, comment: 'Their cybersecurity audit identified critical vulnerabilities we had no idea existed. Potentially saved us millions in breach costs.', user_name: 'James Pretorius', company: 'CISO, SecureBank' },
        { id: 6, rating: 5, comment: 'Best tech partner we have ever had. Their paid ads management tripled our online revenue in just 6 months with a consistent 5x ROAS.', user_name: 'Amina Hassan', company: 'Founder, StyleHub' },
      ];
    }
    recentBlogs.value = d.recent_blogs || [];
    settings.value = d.settings || {};
  } catch (error) {
    console.error('Error fetching home data:', error);
  }
}

async function fetchFaqs() {
  try {
    const { data } = await axios.get('/api/v1/home/faqs');
    const cats = data.data?.categories || data.categories || data.data || [];
    const allFaqs: any[] = [];
    (Array.isArray(cats) ? cats : []).forEach((category: any) => {
      if (category.faqs && Array.isArray(category.faqs)) {
        allFaqs.push(...category.faqs);
      }
    });
    faqs.value = allFaqs.slice(0, 8);
  } catch (error) {
    console.error('Error fetching FAQs:', error);
  }
}

// Form Handlers
async function submitQuoteRequest() {
  quoteFormSubmitting.value = true;
  try {
    await axios.post('/api/v1/enquiries', {
      type: 'quote',
      name: quoteForm.value.name,
      email: quoteForm.value.email,
      phone: quoteForm.value.phone,
      service: quoteForm.value.service,
      message: quoteForm.value.description,
      budget: quoteForm.value.budget,
      timeline: quoteForm.value.timeline,
    });
    toast.success('Quote request submitted! We will contact you within 24 hours.');
    quoteForm.value = { name: '', email: '', phone: '', service: '', description: '', budget: '', timeline: '' };
  } catch (error) {
    console.error('Error submitting quote:', error);
    toast.error('Failed to submit quote request. Please try again.');
  } finally {
    quoteFormSubmitting.value = false;
  }
}

async function submitNewsletter() {
  newsletterSubmitting.value = true;
  try {
    await axios.post('/api/v1/newsletter/subscribe', { email: newsletterEmail.value });
    toast.success('Successfully subscribed to our newsletter!');
    newsletterEmail.value = '';
  } catch (error) {
    console.error('Error subscribing to newsletter:', error);
    toast.error('Failed to subscribe. Please try again.');
  } finally {
    newsletterSubmitting.value = false;
  }
}

async function submitContactForm() {
  contactFormSubmitting.value = true;
  try {
    await axios.post('/api/v1/enquiries', {
      type: 'contact',
      name: contactForm.value.name,
      email: contactForm.value.email,
      phone: contactForm.value.phone,
      message: contactForm.value.message,
    });
    toast.success('Message sent successfully! We will get back to you soon.');
    contactForm.value = { name: '', email: '', phone: '', message: '' };
  } catch (error) {
    console.error('Error submitting contact form:', error);
    toast.error('Failed to send message. Please try again.');
  } finally {
    contactFormSubmitting.value = false;
  }
}

// Helpers
function toggleFaq(index: number) {
  openFaqIndex.value = openFaqIndex.value === index ? null : index;
}

function formatDate(dateStr: string) {
  if (!dateStr) return '';
  return new Date(dateStr).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
}

function animateCounter(element: HTMLElement) {
  const target = parseInt(element.dataset.target || '0');
  const suffix = element.dataset.suffix || '';
  const duration = 2000;
  const step = Math.ceil(target / (duration / 16));
  let current = 0;
  const timer = setInterval(() => {
    current += step;
    if (current >= target) {
      current = target;
      clearInterval(timer);
    }
    element.textContent = current.toLocaleString() + suffix;
  }, 16);
}

// On Mounted
onMounted(async () => {
  await Promise.all([
    fetchHomeData(),
    fetchFaqs(),
  ]);

  // Counter animation
  setTimeout(() => {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          animateCounter(entry.target as HTMLElement);
          observer.unobserve(entry.target);
        }
      });
    });
    counterRefs.value.forEach((el) => {
      if (el) observer.observe(el);
    });
  }, 500);
});
</script>

<style scoped>
.hero-swiper :deep(.swiper-pagination-bullet) {
  width: 8px;
  height: 8px;
  background: white;
  opacity: 0.4;
  transition: all 0.3s;
}
.hero-swiper :deep(.swiper-pagination-bullet-active) {
  background: white;
  opacity: 1;
  width: 20px;
  border-radius: 4px;
}
</style>
