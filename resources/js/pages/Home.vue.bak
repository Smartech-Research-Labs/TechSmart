                <p v-if="slide.description" class="text-gray-300 text-sm md:text-base leading-relaxed mb-8 max-w-lg">{{ slide.description }}</p>
                <div class="flex flex-wrap gap-3">
                  <router-link v-if="slide.cta_text && slide.cta_link" :to="slide.cta_link" class="px-6 py-3 bg-primary text-white text-sm font-semibold rounded-md hover:bg-primary/90 transition-all duration-200">{{ slide.cta_text }}</router-link>
                  <router-link v-if="slide.cta_text_2 && slide.cta_link_2" :to="slide.cta_link_2" class="px-6 py-3 border border-white/40 text-white text-sm font-medium rounded-md hover:bg-white/10 transition-all duration-200">{{ slide.cta_text_2 }}</router-link>
                </div>
              </div>
            </div>
          </div>
        </SwiperSlide>
      </Swiper>
    </section>

