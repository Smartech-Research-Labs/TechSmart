        <div class="text-center mb-10">
          <p class="text-primary text-xs font-semibold tracking-widest uppercase mb-3">FAQ</p>
          <h2 class="text-2xl md:text-3xl font-bold text-foreground leading-tight mb-3">Frequently Asked Questions</h2>
          <p class="text-muted-foreground text-sm">Find answers to common questions about our services.</p>
        </div>

        <div class="space-y-2">
          <div v-for="(faq, idx) in faqs" :key="faq.id" class="bg-card border border-border rounded-lg overflow-hidden">
            <button @click="toggleFaq(idx)" class="w-full px-5 py-4 flex items-center justify-between text-left hover:bg-muted/30 transition-colors">
              <span class="font-medium text-foreground text-sm pr-6">{{ faq.question }}</span>
              <svg class="w-4 h-4 text-muted-foreground shrink-0 transition-transform duration-200" :class="{ 'rotate-180': openFaqIndex === idx }" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path d="M19 9l-7 7-7-7" />
              </svg>
            </button>
            <div v-show="openFaqIndex === idx" class="px-5 pb-4">
              <p class="text-muted-foreground text-sm leading-relaxed">{{ faq.answer }}</p>
            </div>
          </div>
        </div>
      </div>
