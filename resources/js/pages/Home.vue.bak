<template>
  <PublicLayout>
    <!-- Hero Section -->
    <section v-if="sliders.length" class="relative">
      <Swiper
        :modules="[Autoplay, Pagination, EffectFade]"
        :slides-per-view="1"
        :effect="'fade'"
        :autoplay="{ delay: 6000, disableOnInteraction: false }"
        :pagination="{ clickable: true }"
        :loop="true"
        class="hero-swiper"
      >
        <SwiperSlide v-for="slide in sliders" :key="slide.id">
          <div class="relative min-h-[55vh] md:min-h-[65vh] flex items-center">
            <div class="absolute inset-0 z-0">
              <img v-if="slide.image_url" :src="slide.image_url" :alt="slide.title" class="w-full h-full object-cover" />
              <div class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/60 to-black/30"></div>
            </div>
            <div class="relative z-10 container mx-auto px-6 py-16 md:py-20">
