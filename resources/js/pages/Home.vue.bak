                <span class="text-[10px] font-medium text-primary bg-primary/10 px-2 py-0.5 rounded">{{ post.category }}</span>
                <span class="text-muted-foreground text-[10px]">{{ formatDate(post.published_at) }}</span>
              </div>
              <h3 class="text-sm font-semibold text-foreground mb-1.5 group-hover:text-primary transition-colors line-clamp-2">{{ post.title }}</h3>
              <p class="text-muted-foreground text-xs line-clamp-2">{{ post.excerpt }}</p>
