<script setup lang="ts">
import { ref } from 'vue';
import { useRouter, useRoute } from 'vue-router';
import { useAuthStore } from '@/stores/auth';
import { Button } from '@/components/ui/button';
import { Input } from '@/components/ui/input';
import { Label } from '@/components/ui/label';
import AuthBase from '@/layouts/AuthLayout.vue';

const router = useRouter();
const route = useRoute();
const authStore = useAuthStore();

const form = ref({
  email: '',
  password: '',
  remember: false,
});
const errors = ref<Record<string, string>>({});
const processing = ref(false);
const googleProcessing = ref(false);
const showPassword = ref(false);

async function handleSubmit() {
  processing.value = true;
  errors.value = {};

  try {
    await authStore.login({
      email: form.value.email,
      password: form.value.password,
    });

    const redirect = (route.query.redirect as string) || '/dashboard';
    router.push(redirect);
  } catch (err: any) {
    if (err.response?.data?.errors) {
      const serverErrors = err.response.data.errors;
      for (const key in serverErrors) {
        errors.value[key] = Array.isArray(serverErrors[key])
          ? serverErrors[key][0]
          : serverErrors[key];
      }
    } else {
      errors.value.email = err.response?.data?.message || 'Login failed. Please try again.';
    }
  } finally {
    processing.value = false;
  }
}

async function handleGoogleSignIn() {
  googleProcessing.value = true;
  try {
    // Redirect to Laravel Socialite Google OAuth endpoint
    window.location.href = `${import.meta.env.VITE_API_URL}/auth/google/redirect`;
  } catch (err) {
    errors.value.email = 'Google sign-in failed. Please try again.';
    googleProcessing.value = false;
  }
}
</script>

<template>
  <AuthBase title="Welcome back" description="Sign in to your account to continue">
    <div class="w-full max-w-md mx-auto">

      <!-- Card wrapper -->
      <div class="relative bg-[#0d1421] border border-[#1e293b] rounded-2xl p-8 shadow-2xl shadow-black/40">

        <!-- Subtle top accent line -->
        <div class="absolute top-0 left-8 right-8 h-px bg-gradient-to-r from-transparent via-[#00d4aa]/60 to-transparent rounded-full"></div>

        <!-- Header -->
        <div class="mb-8 text-center">
          <div class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-[#00d4aa]/10 border border-[#00d4aa]/20 mb-4">
            <svg class="w-6 h-6 text-[#00d4aa]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" />
            </svg>
          </div>
          <h1 class="text-2xl font-bold text-white tracking-tight">Welcome back</h1>
          <p class="mt-1.5 text-sm text-[#64748b]">Sign in to your account to continue</p>
        </div>

        <!-- Google Sign In -->
        <button
          type="button"
          @click="handleGoogleSignIn"
          :disabled="googleProcessing || processing"
          class="group relative w-full flex items-center justify-center gap-3 px-4 py-3 rounded-xl border border-[#1e293b] bg-[#050a14] hover:bg-[#0d1421] hover:border-[#2e3d52] text-sm font-medium text-[#e2e8f0] transition-all duration-200 disabled:opacity-50 disabled:cursor-not-allowed focus:outline-none focus:ring-2 focus:ring-[#00d4aa]/30"
        >
          <!-- Google spinner -->
          <svg v-if="googleProcessing" class="w-4 h-4 animate-spin text-[#64748b]" viewBox="0 0 24 24" fill="none">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/>
          </svg>
          <!-- Google icon -->
          <svg v-else class="w-4 h-4 flex-shrink-0" viewBox="0 0 24 24">
            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
            <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
          </svg>
          <span>{{ googleProcessing ? 'Redirecting...' : 'Continue with Google' }}</span>
        </button>

        <!-- Divider -->
        <div class="flex items-center gap-3 my-6">
          <div class="flex-1 h-px bg-[#1e293b]"></div>
          <span class="text-xs text-[#64748b] font-medium uppercase tracking-wider">or</span>
          <div class="flex-1 h-px bg-[#1e293b]"></div>
        </div>

        <!-- Error banner -->
        <div
          v-if="errors.email && !errors.email.includes('@')"
          class="flex items-start gap-3 p-3.5 mb-5 rounded-xl bg-red-500/10 border border-red-500/20"
        >
          <svg class="w-4 h-4 text-red-400 mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
          </svg>
          <p class="text-sm text-red-400">{{ errors.email }}</p>
        </div>

        <!-- Login Form -->
        <form @submit.prevent="handleSubmit" class="space-y-5">

          <!-- Email field -->
          <div class="space-y-1.5">
            <Label for="email" class="text-sm font-medium text-[#94a3b8]">Email address</Label>
            <div class="relative">
              <div class="absolute inset-y-0 left-3.5 flex items-center pointer-events-none">
                <svg class="w-4 h-4 text-[#475569]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"/>
                </svg>
              </div>
              <Input
                id="email"
                v-model="form.email"
                type="email"
                required
                autofocus
                autocomplete="email"
                placeholder="you@example.com"
                :class="[
                  'pl-10 h-11 bg-[#050a14] border rounded-xl text-[#e2e8f0] placeholder:text-[#334155] transition-all duration-200',
                  'focus:ring-2 focus:ring-[#00d4aa]/30 focus:border-[#00d4aa]/50',
                  errors.email ? 'border-red-500/50 focus:ring-red-500/20' : 'border-[#1e293b] hover:border-[#2e3d52]'
                ]"
              />
            </div>
            <p v-if="errors.email" class="flex items-center gap-1.5 text-xs text-red-400 mt-1">
              <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
              </svg>
              {{ errors.email }}
            </p>
          </div>

          <!-- Password field -->
          <div class="space-y-1.5">
            <div class="flex items-center justify-between">
              <Label for="password" class="text-sm font-medium text-[#94a3b8]">Password</Label>
              <router-link
                to="/forgot-password"
                class="text-xs text-[#00d4aa] hover:text-[#00d4aa]/80 font-medium transition-colors duration-150"
              >
                Forgot password?
              </router-link>
            </div>
            <div class="relative">
              <div class="absolute inset-y-0 left-3.5 flex items-center pointer-events-none">
                <svg class="w-4 h-4 text-[#475569]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z"/>
                </svg>
              </div>
              <Input
                id="password"
                v-model="form.password"
                :type="showPassword ? 'text' : 'password'"
                required
                autocomplete="current-password"
                placeholder="••••••••"
                :class="[
                  'pl-10 pr-11 h-11 bg-[#050a14] border rounded-xl text-[#e2e8f0] placeholder:text-[#334155] transition-all duration-200',
                  'focus:ring-2 focus:ring-[#00d4aa]/30 focus:border-[#00d4aa]/50',
                  errors.password ? 'border-red-500/50 focus:ring-red-500/20' : 'border-[#1e293b] hover:border-[#2e3d52]'
                ]"
              />
              <button
                type="button"
                @click="showPassword = !showPassword"
                class="absolute inset-y-0 right-3.5 flex items-center text-[#475569] hover:text-[#94a3b8] transition-colors duration-150 focus:outline-none"
              >
                <!-- Eye open -->
                <svg v-if="!showPassword" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
                <!-- Eye closed -->
                <svg v-else class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3.98 8.223A10.477 10.477 0 001.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.45 10.45 0 0112 4.5c4.756 0 8.773 3.162 10.065 7.498a10.523 10.523 0 01-4.293 5.774M6.228 6.228L3 3m3.228 3.228l3.65 3.65m7.894 7.894L21 21m-3.228-3.228l-3.65-3.65m0 0a3 3 0 10-4.243-4.243m4.242 4.242L9.88 9.88"/>
                </svg>
              </button>
            </div>
            <p v-if="errors.password" class="flex items-center gap-1.5 text-xs text-red-400 mt-1">
              <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
              </svg>
              {{ errors.password }}
            </p>
          </div>

          <!-- Remember me -->
          <div class="flex items-center gap-2.5">
            <button
              type="button"
              role="checkbox"
              :aria-checked="form.remember"
              @click="form.remember = !form.remember"
              :class="[
                'relative w-9 h-5 rounded-full transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-[#00d4aa]/30 flex-shrink-0',
                form.remember ? 'bg-[#00d4aa]' : 'bg-[#1e293b]'
              ]"
            >
              <span
                :class="[
                  'absolute top-0.5 left-0.5 w-4 h-4 rounded-full bg-white shadow-sm transform transition-transform duration-200',
                  form.remember ? 'translate-x-4' : 'translate-x-0'
                ]"
              ></span>
            </button>
            <span class="text-sm text-[#64748b] select-none cursor-pointer" @click="form.remember = !form.remember">
              Remember me for 30 days
            </span>
          </div>

          <!-- Submit button -->
          <button
            type="submit"
            :disabled="processing || googleProcessing"
            class="relative w-full h-11 rounded-xl font-semibold text-sm transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-[#00d4aa]/50 focus:ring-offset-2 focus:ring-offset-[#0d1421] disabled:opacity-60 disabled:cursor-not-allowed overflow-hidden group"
            :class="processing ? 'bg-[#00d4aa]/80' : 'bg-[#00d4aa] hover:bg-[#00bfa0] active:scale-[0.98]'"
          >
            <!-- Shimmer effect -->
            <span class="absolute inset-0 bg-gradient-to-r from-transparent via-white/10 to-transparent -translate-x-full group-hover:translate-x-full transition-transform duration-700 ease-in-out pointer-events-none"></span>

            <span class="relative flex items-center justify-center gap-2 text-[#050a14]">
              <svg v-if="processing" class="w-4 h-4 animate-spin" viewBox="0 0 24 24" fill="none">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/>
              </svg>
              <svg v-else class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"/>
              </svg>
              {{ processing ? 'Signing in...' : 'Sign in' }}
            </span>
          </button>
        </form>

        <!-- Sign up link -->
        <p class="mt-6 text-center text-sm text-[#64748b]">
          Don't have an account?
          <router-link
            to="/register"
            class="text-[#00d4aa] hover:text-[#00bfa0] font-semibold transition-colors duration-150 ml-1"
          >
            Create one free →
          </router-link>
        </p>

        <!-- Subtle bottom accent -->
        <div class="absolute bottom-0 left-8 right-8 h-px bg-gradient-to-r from-transparent via-[#1e293b] to-transparent"></div>
      </div>

      <!-- Trust badges -->
      <div class="flex items-center justify-center gap-5 mt-6">
        <div class="flex items-center gap-1.5 text-xs text-[#475569]">
          <svg class="w-3.5 h-3.5 text-[#00d4aa]" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd"/>
          </svg>
          SSL Secured
        </div>
        <div class="w-px h-3 bg-[#1e293b]"></div>
        <div class="flex items-center gap-1.5 text-xs text-[#475569]">
          <svg class="w-3.5 h-3.5 text-[#00d4aa]" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M2.166 4.999A11.954 11.954 0 0010 1.944 11.954 11.954 0 0017.834 5c.11.65.166 1.32.166 2.001 0 5.225-3.34 9.67-8 11.317C5.34 16.67 2 12.225 2 7c0-.682.057-1.35.166-2.001zm11.541 3.708a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
          </svg>
          Privacy Protected
        </div>
        <div class="w-px h-3 bg-[#1e293b]"></div>
        <div class="flex items-center gap-1.5 text-xs text-[#475569]">
          <svg class="w-3.5 h-3.5 text-[#00d4aa]" fill="currentColor" viewBox="0 0 20 20">
            <path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          2FA Available
        </div>
      </div>
    </div>
  </AuthBase>
</template>