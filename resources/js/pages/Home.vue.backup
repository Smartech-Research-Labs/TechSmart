<script setup lang="ts">
import { ref, onMounted } from 'vue';
import PublicLayout from '@/layouts/PublicLayout.vue';
import { useCmsStore } from '@/stores/cms';

const cmsStore = useCmsStore();
const homeData = ref(cmsStore.homeData);
const counterRefs = ref<HTMLElement[]>([]);

const services = [
  { title: 'Web Development', slug: 'web-development', description: 'Custom web applications built with Laravel, Vue, React and modern frameworks. From landing pages to enterprise platforms.', icon: '<svg class="w-7 h-7 text-primary" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" /></svg>' },
  { title: 'Mobile App Development', slug: 'mobile-app-development', description: 'Native iOS & Android apps plus cross-platform solutions with React Native and Flutter for seamless user experiences.', icon: '<svg class="w-7 h-7 text-primary" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" /></svg>' },
  { title: 'Automation & AI', slug: 'automation', description: 'Intelligent process automation, AI integrations, chatbots and workflow systems that save time and reduce costs.', icon: '<svg class="w-7 h-7 text-primary" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>' },
  { title: 'SaaS Development', slug: 'saas-development', description: 'End-to-end SaaS product development — from MVP to scale. Multi-tenant architecture, billing, and analytics built in.', icon: '<svg class="w-7 h-7 text-primary" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z" /></svg>' },
  { title: 'E-Commerce Solutions', slug: 'e-commerce', description: 'Custom online stores, marketplace platforms, and payment integrations. Shopify, WooCommerce, or fully custom builds.', icon: '<svg class="w-7 h-7 text-primary" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 100 4 2 2 0 000-4z" /></svg>' },
  { title: 'Deployment & Hosting', slug: 'deployment-hosting', description: 'Cloud infrastructure, CI/CD pipelines, Docker, Kubernetes, and managed hosting. We keep your apps running smoothly.', icon: '<svg class="w-7 h-7 text-primary" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 12H3l9-9 9 9h-2M5 12v7a2 2 0 002 2h10a2 2 0 002-2v-7" /></svg>' },
];

const whyFeatures = [
  { title: 'Agile Development', description: 'Sprint-based delivery with weekly demos and continuous feedback loops.' },
  { title: 'Scalable Architecture', description: 'Built for growth with microservices, cloud-native design, and best practices.' },
  { title: 'Dedicated Support', description: '24/7 monitoring, maintenance, and rapid response times for all clients.' },
  { title: 'Transparent Pricing', description: 'Clear, upfront pricing with no hidden fees. Pay for what you need.' },
];

const processSteps = [
  { title: 'Discovery', description: 'We analyze your needs, goals, and market to define the perfect strategy.' },
  { title: 'Design', description: 'UI/UX design with prototypes and wireframes for seamless user experience.' },
  { title: 'Develop', description: 'Agile development with clean code, testing, and regular progress updates.' },
  { title: 'Deploy', description: 'Launch with CI/CD, monitoring, and ongoing support to ensure success.' },
];

const testimonials = [
  { name: 'Sarah Johnson', role: 'CEO, TechFlow Inc.', text: 'TechSmart transformed our entire digital infrastructure. Their team delivered a scalable platform that doubled our revenue in 6 months.' },
  { name: 'Michael Chen', role: 'CTO, DataVerse', text: 'The automation solutions they built saved us 200+ hours per month. Their expertise in AI and workflow optimization is unmatched.' },
  { name: 'Emily Mbeki', role: 'Founder, CloudStore', text: 'From concept to launch in 8 weeks. TechSmart built our e-commerce platform with everything we needed and more. Highly recommended!' },
];

function formatDate(dateStr: string) {
  if (!dateStr) return '';
  return new Date(dateStr).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
}

onMounted(async () => {
  if (!homeData.value) {
    await cmsStore.fetchHomeData().catch(() => {});
    homeData.value = cmsStore.homeData;
  }
  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) { animateCounter(entry.target as HTMLElement); observer.unobserve(entry.target); }
    });
  });
  counterRefs.value.forEach((el) => { if (el) observer.observe(el); });
});

function animateCounter(element: HTMLElement) {
  const target = parseInt(element.dataset.target || '0');
  const suffix = element.dataset.suffix || '';
  const duration = 2000;
  const step = Math.ceil(target / (duration / 16));
  let current = 0;
  const timer = setInterval(() => {
    current += step;
    if (current >= target) { current = target; clearInterval(timer); }
    element.textContent = current.toLocaleString() + suffix;
  }, 16);
}
</script>

<style scoped>
@keyframes float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-12px); } }
@keyframes float-delayed { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-16px); } }
@keyframes float-slow { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-8px); } }
.animate-float { animation: float 4s ease-in-out infinite; }
.animate-float-delayed { animation: float-delayed 5s ease-in-out infinite 0.5s; }
.animate-float-slow { animation: float-slow 6s ease-in-out infinite 1s; }
</style>
